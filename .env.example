# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldurun.
# `.env.local` git'e girmez.

# Supabase proje adresi ve herkese açık (publishable) anahtar.
# Tarayıcıya gönderildikleri için gizli değildir; erişimi RLS politikaları sınırlar.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Yalnızca sunucu tarafında kullanılır (kullanıcı davet etme gibi yönetim işleri).
# RLS'i tamamen aşar, asla istemci koduna veya depoya girmemeli.
SUPABASE_SERVICE_ROLE_KEY=

# Reyon etiketlerindeki karekodların işaret ettiği genel adres.
# Örnek: https://reyonstok.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
