# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# örnek dosya depoda dursun, gerçek anahtarlar içermiyor
!.env.example

# supabase yerel geliştirme çıktıları
/supabase/.branches
/supabase/.temp

# node_modules'tan kopyalanan ZXing WASM dosyası (npm run sync:wasm üretir)
/public/zxing/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ajan araçlarının indirdiği yetenek dosyaları. node_modules gibi: içerik dışarıdan
# geliyor, hangi sürümün kullanıldığını skills-lock.json zaten kaydediyor.
/.agents/
/.claude/
